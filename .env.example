# Vault Configuration
VAULT_URI=http://localhost:8200
VAULT_ROLE_ID=your-role-id-here
VAULT_SECRET_ID=your-secret-id-here

# S3 Configuration
S3_URI=s3://your-region
S3_BUCKET=your-config-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Config Server Security (optional)
CONFIG_SERVER_USERNAME=admin
CONFIG_SERVER_PASSWORD=secret